{
  "capture": {
    "source": "design/capture/V3-codex-after-quit-shell-screen.json",
    "state": "shell-after-quit",
    "redactions": {
      "<user>@<host>": "terminal user and machine name",
      "<workspace>": "repository workspace path",
      "<scratch>": "temporary task directory",
      "<session-id>": "Codex resume identifier",
      "<redacted>": "token usage counts"
    }
  },
  "terminal": {
    "status": "running",
    "tail": [
      "<user>@<host>:<workspace> > cd <scratch> && codex",
      "Disconnected from this task. Any running work continues.",
      "Reconnect: codex resume <session-id>",
      "Stop the current turn: run codex agents, select this task, and press x.",
      "Token usage so far: total=<redacted> input=<redacted> output=<redacted>",
      "<user>@<host>:<scratch> >"
    ],
    "truncated": true,
    "limited": false,
    "source": "screen"
  }
}
